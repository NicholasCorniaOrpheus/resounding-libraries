@misc{Łukawski_24184,
 abstract = {This lecture for film music and experimental music composers at the ArtEZ University of the Arts in Arnhem, Netherlands aimed to discuss the role of Artificial Intelligence tools in the creative process of music composers by discussing the strategic use of AI as a tool within the creative process from various creative angles, including treating AI as an independent agent, a tool for embedding automated intelligent behaviour within the creative work, and as a co-creator in the creative process. Topics discussed included: Introduction to AI-thinking in music, Music-theory based algorithms vs. AI models?, Music as a multidimensional space of parameters, How large is the musical space?, AI as mimicking human brain, Machine learning, Types of AI, What can AI do in music?, AI vs. Generative AI, Generative Art, New roles of artists (as system builders and curators), Long-form / Short-form Generative Art, Example: Sebastian Macchia - Nobody’s songs (2020), DADABOTS (2019), Stochastic Pirate Radio, Platforms such as Suno and Udio, Problems of Datasets. The course discussed several music AI workflows, including the use of tools such as Google Performance RNN, Allegro MIDI Composer (Project Los Angeles), NotaGEN Symbolic Music Generation, and the use of Large Language Models in Music. It also showcased a newly developed device called a GPT MIDI Composer, where a Large Language Model is used to learn and generate new music in a MIDI format. },
 address = {Arnhem, The Netherlands},
 author = {Łukawski, Adam},
 doi = {},
