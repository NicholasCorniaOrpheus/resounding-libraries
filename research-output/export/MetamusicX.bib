@misc{Castro-Magas_24284,
 abstract = {Radically Embodied Performance as Musical Structure (REPaMS) is an Artistic Research project that seeks to describe, analyse and explore performer's creativity in particular relation to complex and experimental guitar music and performing practices within Western Art Music. This project is centrally advocated on recent compositional practices evidencing a performative transformation of musical material, in which sound-producing actions are immanent layers of the music as if the composer is bypassing the performer as a person and scoring directly for her body challenging the performer's role as a creative agent. Based on the premise that performers do not reproduce but create musical structures, REPaMS rethinks performer's creativity as the radically embodied creation of musical structures. The action is structured around three main case-studies as seen through three different epistemological/ methodological lens. By examining recent notational/performing practices as both products and processes, REPaMS pursues an artistic research methodology in which the interaction between notations, artistic practices and further non-musical elements emerging as process, satisfying standards of rigor, replicability and transmissibility, while still remaining flexible to the emerging possibilities and constraints that these notations imply. REPaMS will contribute to build analogical bridges between analytical and embodied perspectives, exerting an impact upon artistic and research practices, formats of presentation for artistic research outputs and performance pedagogy. The action will enhance the ERs skills and future employability prospects, opening new training opportunities both as an academic and an artist-researcher, furthering his ability to plan, organise, develop his dissemination and public outreach competencies, and reinforcing his professional networks.

},
 address = {Ghent},
 author = {Castro-Magas, Diego},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 keywords = {},
 note = {FARM 2025 is an Erasmus Blended Intensive Programme jointly organized by four music institutions: Conservatorio Santa Cecilia of Rome (Italy, Coordinating Institution), Universidade de Aveiro (Portugal), Royal Irish Academy of Music Dublin (Ireland), and Orpheus Instituut of Gent (Belgium).

FARM stands for “Fostering Artistic Research in Music”. This intensive international programme held in English addresses master and doctoral students (performers, composers, and other musical figures) interested in the topic of artistic research.

In this programme, students will discover how to rethink and improve their music practice through artistic research and to respond to the economic, cultural, and technological environment that they are confronted with.},
 publisher = {Orpheus Instituut},
 title = {Radically Embodied Performance as Musical Structure},
 type = {non-written output},
 url = {https://orpheusinstituut.be/education/other/farm},
 year = {2025}
}


@phdthesis{Reyes_22776,
 abstract = {This doctoral proposal embarks on an artistic research project aimed at the development and refinement of my transdisciplinary compositional practice, with a distinct focus on exploring non-anthropocentric approaches to the creation of musical and multimedia works.

The overarching objective is to transcend conventional paradigms that centre human beings as the main characters in musical performances, exploring alternative conceptualisations of artistic expression that prioritise interconnectedness with the broader ecological fabric.
Grounded in ecological theories, biological imagination, and posthuman philosophies, this research seeks to develop new modes of art-making that engage with and reflect upon the agency of non-human entities and natural processes.

This research endeavour will contribute to the emergence of new compositional languages that challenge anthropocentric norms, offering a fresh perspective on the role of the composer/director in artistic collective processes and on the transformative potential of non-anthropocentric musical practices.},
 address = {Ghent},
 author = {Reyes, Alicia and Assis, Paulo de and Willson, Rachel Beckles},
 doi = {},
 howpublished = {open, Peer-reviewed},
 keywords = {Ecology},
 note = {},
 pages = {},
 school = {Orpheus Instituut},
 title = {Non-anthropocentric Composition: Decentralising the Human through Contemporary Performance Practices},
 type = {dissertation},
 url = {https://www.docartes.be/en/research-projects/non-anthropocentric-composition-decentralising-the-human-through-contemporary-performance-practices},
 year = {2028}
}

@misc{Reyes_24295,
 abstract = {The performance took place in the context of "Thinking through Materialities Hub", a symposium around sustainable materials and practices organised by the Sustainable Theatre Lab at the Ligeti Zentrum (Hamurg).

The instrumental theatre piece unfolds its narrative around a recently discovered new structure: Plastiglomerates. Plastiglomerates are conglomerates composed of a mixture of sediment grains and other natural residues such as shells or wood, held together by plastic. They are considered a potential marker of the Anthropocene – an unofficial epoch of the Quaternary period proposed by some social scientists, ecologists, and geologists.},
