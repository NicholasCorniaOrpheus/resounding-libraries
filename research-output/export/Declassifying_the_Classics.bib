@misc{Boondiskulchok_22020,
 abstract = {Instruments used:
Erard 1882;
Strings with open-wound gut and late 19th set up.},
 address = {Berlin, Germany},
 author = {Boondiskulchok, Prach},
 doi = {},
 howpublished = {Closed, Peer-reviewed},
 keywords = {},
 note = {The Linos Piano Trio presents the music of Ravel in a fascinating light, performing on period instruments and exploring Ravel’s own relationship with the past.

As well as the Piano Trio in A minor, the disc includes Linos’s own arrangements of Ravel’s Pavane pour une infante défunte and Le Tombeau de Couperin — an extension of their ‘Stolen Music’ project, in which they collaboratively re-imagine orchestral masterpieces as if they had been initially conceived for Piano Trio.

By using period instruments, the Linos players find a wider range of colour in Ravel’s music, and a more timbrally-entwined balance between the three instruments. Violinist Konrad Elias-Trostmann and cellist Vladimir Waltham play on a combination of plain and wound gut strings, while Pianist Prach Boondiskulchok performs on an 1882 Érard Concert Grand piano, the same make and a very similar model to the piano Ravel himself owned and composed with.

While the Pavane, composed in 1899, depicts an imagined dance in a 17th-century Spanish court and the Tombeau presents a series of neo-baroque dances, composed against the backdrop of the First World War, the Linos players have also come to see the Piano Trio as a set of dances. Completed in 1914, immediately before Ravel enlisted for military service, the Trio speaks to Le Tombeau across the historical divide of the outbreak of war in their ‘search for lost dances’: “the Piano Trio imagines dances of his childhood, dances of faraway places, dances of victory and death, while Le Tombeau reimagines dances from faraway times”.},
 publisher = {Deutsche Grammophon},
 title = {Ravel: In Search of Lost Dance - Premiere recording of Ravel's Piano Trio on historical instruments},
 type = {non-written output},
 url = {https://www.youtube.com/watch?v=g1uleyZP_iU},
 year = {2023}
}




@misc{Montebugnoli_21926,
 abstract = {October 1803: On hearing Beethoven play the Eroica symphony on his new Erard Frères piano, a witness remarked, “Heaven and Earth must shake at its performance.” Inspired by this historical scene, Luca Montebugnoli has created a new arrangement of the symphony tailored to a unique replica of Beethoven’s Erard. By delivering a novel interpretation of an iconic work, Montebugnoli revives the neglected art of piano arrangement, while also exploring the full potential of what was in Beethoven’s life a revolutionary instrument.

Program:
- Joseph Haydn, Die Schöpfung, Hob. XXI:2, Einleitung: Die Vorstellung des Chaos, Largo, arranged by Daniel Steibelt
- Ludwig van Beethoven, Symphony No. 3 in E-flat major, op. 55, “Eroica”, arranged by Luca Montebugnoli
- Christoph Willibald Gluck, Orphée et Eurydice, Wq. 41, Act II, Scene 2: Ballet des ombres heureuses, Andante grazioso, arranged by Jean-Louis Adam ; Echo et Narcisse, Wq. 47, Prologue, Scene 2: Air de danse—Air des peines, Air de danse, arranged by Jean-Louis Adam

Instrument:
Replica of Beethoven’s Erard Frères piano en forme de clavecin (Paris, 1803), by Chris Maene (Ruiselede, 2016)

Liner notes :
- Luca Montebugnoli, "Arranging Beethoven’s “Eroica” for His 1803 Erard Frères piano en forme de clavecin"; 
- Tom Beghin, “Recording a Unique Arrangement of an Iconic Work. A brief note by Tom Beghin”},
 address = {Bruges},
 author = {Montebugnoli, Luca and Beghin, Tom},
 doi = {},
 howpublished = {Closed, Not peer-reviewed},
 keywords = {Arrangement, Historically informed performance, Piano},
 note = {},
 publisher = {Evil Penguin Record Classic},
 title = {EROICA / ERARD},
 type = {non-written output},
 url = {https://orpheusinstituut.be/en/beethovenerard/cd-eroica-erard},
 year = {2024}
}

