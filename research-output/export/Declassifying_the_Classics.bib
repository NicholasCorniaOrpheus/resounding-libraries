@misc{Zafeiropoulos_24322,
 abstract = {},
 address = {Ithaca, NY, USA},
 author = {Zafeiropoulos, Anastasios},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {Revisions were a recurring theme in Clementi’s career. They emerge as the “central ‘problem’ posed by his methods as a composer, publisher and editor” (Stewart-MacDonald, 2002). Similarly to his celebrated op. 2, Clementi “updated” and “improved” his Progressive Sonatinas op. 36 multiple times over a span of more than twenty years from 1797 to c. 1820. Both revision processes seem to reflect evolving ideas about performance styles and notation, as well as a strong affinity with the ever-developing English piano manufacturing industry during the composer’s lifetime. Rather than marketing strategies that facilitate the pursuit of financial gain (Platinga 1977) or “disturb [...] the original effect of the music” (Wollenberg 2018), I view revisions as opportunities for updating musical notation to the most recent available pianos, “born from a unique negotiation between original and ‘new and improved’” (Helyard 2022).
When it comes to fingered publications, Clementi’s predilection for revision becomes all the more relevant, as his fundamental system of fingering—the one that had defined his own success as a pianist—remained intact. Following the revised edition of his excruciatingly difficult Toccata op. 11 (1792), where he revealed the secrets of this success for the first time, op. 36 was his second publication with fingerings, functioning as a supplement to his method op. 42 and kickstarting a whole series of didactic works—opp. 42, 43, and 44. With his revisions not only did Clementi satisfy the English amateur’s craving for novelty, but he also provided aspiring keyboardists of his time with the tools to conquer difficulty in music systematically.
Using examples from Clementi’s piano method (1801), I will focus on Clementi’s fingering system, which revolves around interconnecting hand positions that must remain in close contact with the keys. I will demonstrate the crucial role of such a system in the act of reading a musical text, and will examine changes in fingering and articulation between the first and fifth editions of op. 36 (1797/c. 1815) in relation to the elusive “original effect of the music” and to changing instrumental affordance.},
 publisher = {CCHK Cornell University},
 title = {With considerable improvements: English Pianos with Additional Keys and Fingering in Clementi’s Revised Progressive Sonatinas, Op. 36},
 type = {non-written output},
 url = {https://historicalkeyboards.as.cornell.edu/forte-piano-2025},
 year = {2025}
}

@misc{Zafeiropoulos_24326,
 abstract = {},
 address = {Vera, Almeria, Spain},
 author = {Zafeiropoulos, Anastasios},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {Scarlatti's Chefs d’œuvre (1791) was Clementi's first publication of keyboard pieces by his fellow Italian composer. By contributing to the ‘Scarlatti tradition’ in England (Newton, 1939), Clementi followed in the footsteps of other leading eighteenth-century publishers, such as Roseingrave, Johnson, Welcker, and Preston. In this edition he followed the original score closely, despite adding dynamics to appeal to the piano player. In his Introduction to the Art of Playing on the Piano Forte (1801), Clementi printed four Scarlatti pieces—K. 34, 35, 40, and 42—that featured as ‘lessons’ alongside other compositions representing both modern and ‘ancient’ music. This was an integral part of the shift from a scholarly to a pedagogical and performed canon in late-eighteenth-century London (Weber, 1994). Instead of adding dynamics, however, Clementi deviated significantly from Roseingrave’s editions by elongating slurs, joining stems and beams, omitting or specifying ornaments, and, crucially adding fingering for each note, with the aim of teaching the budding pianists of his time the ‘basis of the art of fingering’ (Clementi, 1801). 
Drawing on examples from Clementi’s piano method (1801), I will explore the significance of the ‘small’ form of Scarlatti’s pieces (Sutcliffe, 2009) within Clementi’s fingering system. Rooted in ‘sensationism’ (Helyard, 2022), this system revolves around interconnected hand positions that maintain close contact with the keys. Ultimately, I will demonstrate the crucial role of this system, combined with the aforementioned updates to notation, in the act of reading a musical text on the pianoforte.},
 publisher = {FIMTE},
 title = {Piano ‘Lessons’ by Scarlatti/Clementi: Scarlatti’s Keyboard Pieces in Clementi’s Introduction, Op. 42},
 type = {non-written output},
 url = {https://www.fimte.org/},
 year = {2025}
}

@misc{Zafeiropoulos_24327,
 abstract = {},
 address = {Helsinki, Finland},
 author = {Zafeiropoulos, Anastasios},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {Similarly to his celebrated op. 2, Clementi revised his Progressive Sonatinas multiple times over a span of more than twenty years from 1797 to c. 1820. Both revision processes seem to reflect evolving ideas about performance styles and notation, as well as a strong affinity to the developing English piano manufacture during the composer’s lifetime. Rather than marketing strategies that facilitate the pursuit of financial gain (Platinga 1977) or “disturb [...] the original effect of the music” (Wollenberg 2018), I see revisions as opportunities for updating musical notation for the most recent available pianos, “born from a unique negotiation between original and ‘new and improved’” (Helyard 2022).
If the publication of op. 2 in 1779 “launched Clementi’s career as an innovator in pianistic virtuosity” (Harrison/Drabkin 2004), op. 36 has become the epitome of Clementi’s legacy as a pedagogue. The revised edition of his Toccata op. 11 (1792) kickstarted a series of meticulously fingered publications of remarkable didactic value—opp. 11, 36, 42, 43, and 44. Being a “proponent of sensationism” (Helyard 2021), Clementi revealed the secrets of his art to the aspiring keyboardists of his time, thereby giving the “best effect” for each passage according to the “character and passion” of the piece (Clementi 1801). Throughout the revisions, the principles of his groundbreaking fingering system, which revolves around interconnecting hand positions in close contact with the keys, remained intact.
Using examples from Clementi’s didactic works, I will demonstrate the crucial role of this system in the act of reading the musical text on the keyboard, before examining changes in fingering and articulation between the first and fifth editions of op. 36 (1797/c. 1813). Finally, I will trace the sensations Clementi’s fingering stimulates in the hand in relation to changing instrumental affordances.},
 publisher = {UniArts Helsinki & Sibelius Academy},
 title = {“A hint of keyboard magic”: Clementi’s Sensational Fingerings in the Revisions of his Toccata and Sonatinas},
 type = {non-written output},
 url = {https://www.uniarts.fi/en/events/doctors-in-performance-dip-2025/},
 year = {2025}
}

