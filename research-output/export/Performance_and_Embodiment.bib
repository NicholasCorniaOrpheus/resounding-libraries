@misc{Worthington_24297,
 abstract = {Training Vortrag: phrasing, character and narrative in Baermann’s Vollständige Clarinett-Schule Opp. 63-64 (1860-64)
The Baermann’s Body project (2023-2025), funded by the UK Arts and Humanities Research Council, is the first in-depth study of the 19th century clarinetist, instrument designer and pedagogue Carl Baermann (1810-1885). The project uses current theories of embodied knowledge from across the performing arts to further understanding of methodologies of artistic research in HIP, and develop strategies for documenting, reflecting on and articulating the modes and cycles of research that take place in the practice room and rehearsal studio (Worthington 2022).
This presentation, illustrated by video documentation, will demonstrate the project methodology though a case study of phrasing and musical meaning in Baermann’s Vollständige Clarinett-Schule (1860-1864) and his 1870 edition of Weber’s Grand Duo Concertante op. 48. Baermann’s detailed indications of breathing, articulation and accentuation tacitly encode a complex, multi-layered approach to phrasing and rubato similar to that observed across the corpus of early recordings (eg Harrison and Slåttebrekk, n. d.). This vortrag can be understood in relation to the traditions of spoken word performance and narrative approaches to musical interpretation that were ubiquitous in Baermann’s wider artistic community (Muns 2017, Torbianelli 2014), practices that he enacted through programmatic annotations, descriptive titles and text underlay in his compositions. When combined with the insights of current practice-research into the relation of imagination, emotion and physical action in historical acting technique (Wentz et al xx), a working method emerges for achieving a deeper understanding of the sense of meaning that underlies C19th instrumental performance style.},
 address = {Bloomington, Indiana, USA},
 author = {Worthington, Emily},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 keywords = {},
 note = {},
 publisher = {Historical Performance Institute, Indiana University},
 title = {'Training Vortrag: Phrasing, Character and Narrative in Baermann’s Vollständige Clarinett-Schule Opp. 63-64 (1860-64)'},
 type = {non-written output},
 url = {https://pure.york.ac.uk/portal/en/activities/ninth-annual-international-conference-in-historical-performance/},
 year = {2024}
}

@misc{Worthington_24298,
 abstract = {The Baermann’s Body project (2023-2025), funded by the UK Arts and Humanities Research Council, is the first in-depth study of the 19th century clarinetist, instrument designer and pedagogue Carl Baermann (1810-1885). Baermann was the most important clarinetist and teacher of the mid-19th century, leaving a rich body of evidence of a performance practice directly linked to composers including Weber, Mendelssohn, Meyerbeer, Liszt, Schumann and Wagner. While there is as yet no proof of direct contact between Baermann and Reinecke, the congruence of their circles of associates and the similarity of their musical outlooks and personalities makes Baermann the most relevant source of evidence for the performance of Reinecke’s works for clarinet.
This presentation, illustrated by live performance, will explore Baermann’s approach to imagination and musical character with reference to his Vollständige Clarinett-Schule (1860-1864), his compositions for clarinet and piano and his transcriptions of Schubert lieder. Baermann’s detailed indications of breathing, articulation and accentuation tacitly encode a complex, multi-layered approach to phrasing and rubato similar to that observed across the corpus of early recordings (eg Harrison and Slåttebrekk, n. d.). This approach can be understood in relation to the traditions of song and spoken word performance, as well as narrative approaches to instrumental music that were ubiquitous in Baermann’s wider artistic community (Muns 2017, Torbianelli 2014), practices that he enacted through programmatic annotations, descriptive titles and text underlay in his compositions for clarinet. The presentation will conclude with a discussion of the application of a Baermann-inspired narrative approach to the second movement of Reinecke’s Trio op. 274 for Clarinet, Horn and Piano, entitled Ein Märchen.},
 address = {Paris},
 author = {Worthington, Emily},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 keywords = {},
 note = {},
 publisher = {La Nouvelle Athènes - Centre des pianos romantiques},
 title = {Training the Imagination: phrasing, character and narrative in mid-19th century instrumental music as seen through the music of Carl Baermann (1811–1885)},
 type = {non-written output},
