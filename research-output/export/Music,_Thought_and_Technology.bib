@phdthesis{Yu_24224,
 abstract = {This research explores speculative socio-technological trajectories to establish a new compositional paradigm, focusing on the concept of the augmented audience through prototyping-based wearables named the Internet of Wearable Musical Things (IoWMT). The study sets up a dual framework: a macro framework for conceptual and theoretical development and a micro framework for technical implementation and experimentation. This dual framework forms the basis of the research process, generating new compositional approaches. Together, they provide the context, techniques, and tools for the compositional practices. This research offers a reflective artistic perspective on our unpredictable technological future by converging fields ranging from computer music, human-computer interaction, speculative aesthetics, transhumanism, and gamification. It also conveys a personal attitude toward contemporary technological development.},
 address = {Ghent},
 author = {Yu, Chonglian and Impett, Jonathan and Monseré, Annelies},
 doi = {},
 howpublished = {open, Peer-reviewed},
 keywords = {},
 note = {},
 pages = {},
 school = {Orpheus Instituut},
 title = {Prototyping a New Compositional Paradigm: The Augmented Audience and the Internet of Wearable Musical Things},
 type = {dissertation},
 url = {https://www.docartes.be/en/research-projects/prototyping-a-new-compositional-paradigm-the-augmented-audience-and-the-internet-of-wearable-musical-things},
 year = {2028}
}

@misc{Yu_24227,
 abstract = {Human Receiver is an artistic project emerging from my current doctoral research, which transforms audience members into active nodes within a cyber-physical performance space through custom-built, networked wearables. The project examines how IoT network structures—centralized, decentralized, and distributed—can serve as compositional frameworks for real-time sonic and structural spatialization. Audiences embody dual identities (physical and digital) that converge at "sonic margins," the mutable boundaries where sound meets perceptual thresholds and networked cognition emerges. Drawing parallels between network topologies, proxemic patterns, and compositional techniques, the project creates dynamic environments that mirror underlying networked digital data flows. Technical implementation utilizes low-cost ESP32-based devices running modified low-latency audio streaming protocols. This presentation will detail the implementation of the cyber-physical IoT infrastructure, the networked wearable design paradigm, audio streaming protocols, and present compositional excerpts that demonstrate the creative outcomes of this project.},
 address = {},
 author = {Yu, Chonglian},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 keywords = {Computer science},
 note = {},
 publisher = {},
 title = {Human Receiver: Network Topologies as Sonic Scores},
 type = {non-written output},
 url = {https://nownetarts.org/nownet-arts-conference-2025},
 year = {2025}
}

