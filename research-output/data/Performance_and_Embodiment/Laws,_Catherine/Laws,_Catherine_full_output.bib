@misc{Laws_24281,
 abstract = {The research project ‘Musical Touch and Vicarious Perception’ combines practice research, empirical studies in embodied perception, and philosophical theory in order to examine how touch, in instrumental performance, mediates musical nuance, and how instruments ‘touch back’, through haptic feedback with affective impact. The project also examines how performer touch operates vicariously, contributing to audiences’ embodied, affective experience. 
For performers, touch is often bound up with proprioceptive navigation of sonic nuance: we feel our way around qualities of tone and timbre. Most studies of musical touch examine how measurable characteristics of touch (velocity, pressure, etc) relate to measurable sonic outcomes. However, touch is multimodal and transposable across the senses; the dynamics of touch in instrumental performance are complex. Touch-related movements affect a performer’s experience of and interaction with haptic-proprioceptive feedback from the instrument. If the dynamic experience of touch changes how we feel as we perform, this entwines the physical experience of ‘touching’ with affective impact – how we are ‘touched’. Moreover, recent research into vicarious perception has shown that we, to different extents, represent in our brains the touch experiences of others, as if they are ours. Thus, the dynamics of touch can form an important role in the ecology of performance: in performers’ interactions with objects (instruments and beyond), materials, and contexts, but also, perhaps, as the basis of forms of embodied empathy. This presentation draws out aspects of this research, using as case studies two new, interdisciplinary performance pieces involving pianos, created through practice research into ‘touch transmission’.
},
 address = {London},
 author = {Laws, Catherine},
 doi = {},
 howpublished = {closed, Not peer-reviewed},
 keywords = {},
 note = {Conference presentation},
 publisher = {Performance Studies Network},
 title = {What am I touching when I play the piano? Musical touch and vicarious perception},
 type = {non-written output},
 url = {https://www.gsmd.ac.uk/whats-on/performance-studies-network-psn-7th-international-conference-2025},
 year = {2023}
}

@misc{Laws_24282,
 abstract = {For musical performers, touch is often bound up with proprioceptive navigation of sonic nuance: we feel our way around qualities of resonance, tone, and timbre. Most studies of musical touch examine how measurable characteristics of touch (velocity, pressure, etc) relate to measurable sonic outcomes. However, touch is multimodal and transposable across the senses; the dynamics of touch in instrumental performance are complex. Touch-related movements affect a performer’s experience of and interaction with haptic-proprioceptive feedback from the instrument. If the dynamic experience of touch changes how we feel as we perform, this entwines the physical experience of ‘touching’ with affective impact – how we are ‘touched’. Moreover, recent research into vicarious perception has shown that we, to different extents, represent in our brains the touch experiences of others, as if they are ours. Thus, the dynamics of touch can form an important role in the ecology of performance: in performers’ interactions with objects (instruments and beyond), materials, and contexts, but also, perhaps, as the basis of forms of embodied empathy – between performers, and between performers and audiences. 
This presentation considers musical touch in terms of interfacing, using as a case study a collaboratively-devised performance piece, Four Hands, for piano and two performers (incorporating text, movement and electronic sound): one outcome of a process of practice research into ‘touch transmission’. The process explored the embodied vicarious experience of the relationship between touch and resonance through (on, in and around) a piano. As (nominally) a pianist and a (‘non-pianist’), we wanted to explore touch as a sonic-affective interface: between performers, between performers and things (the various objects of performance), or between performer(s) and audience. How can tacit, felt experience of musical touch be transferred between bodies? Or, in a piano context, how does (sonic) resonance resonates (kinaesthetically, in the other). 
},
 address = {Warwick, UK},
 author = {Laws, Catherine and Brayshaw, Teresa},
 doi = {},
 howpublished = {closed, Not peer-reviewed},
 keywords = {},
 note = {Conference presentation},
 publisher = {Theatre and Performance Research Association},
 title = {Touch Transmission  (or: what and who are we touching when playing the piano?)},
 type = {non-written output},
 url = {https://warwick.ac.uk/fac/arts/scapvc/theatre/news-and-events/tapraconference2025/},
 year = {2025}
}

@misc{Laws_24285,
 abstract = {Embodied experience of musical performance is simultaneously shared and private, distributed between and through bodies but individual and differentiated in those particular bodies. It is also translated, often subconsciously and instantaneously, in different ways; affectively but also into concepts and associations. Even while music takes effect on (or affect through) the body, the nuanced embodiment of performer action often disappears, subsumed into other forms of musical, affective and/or cultural meaning. But that nuance matters; to performers themselves, for sure, but also across the ecology of performance. How can we expose and transmit aspects of this embodied significance? (And why might we want to?)

My current research explores these questions in the context of the role of touch in musical performance. For this presentation I will draw on one strand of this research, considering musical touch in terms of resonance and interference, and using as a case study a collaboratively-devised performance piece, Four Hands, for piano and two performers (incorporating text, movement and electronic sound); one outcome of a process of practice research into ‘touch transmission’. The process explored the embodied vicarious experience of the relationship between touch and resonance through (on, in and around) a piano. As (nominally) a pianist and a (‘non-pianist’), we wanted to explore touch as a sonic-affective interface: between performers, between performers and things (the various objects of performance), or between performer(s) and audience. How can tacit, felt experience of musical touch be transferred between bodies? Or, in a piano context, how does (sonic) resonance resonate (kinaesthetically, in the other). 
},
 address = {London},
 author = {Laws, Catherine},
 doi = {},
 howpublished = {closed, Not peer-reviewed},
 keywords = {},
 note = {Presentation at research study day},
 publisher = {Royal Musical Association},
 title = {Touch Transmission },
 type = {non-written output},
 url = {https://www.citystgeorges.ac.uk/news-and-events/events/2025/june/embodied-research-methods-in-music-and-sound-study-day/_nocache},
 year = {2025}
}

