@misc{Proehl_24220,
 abstract = {The clavichord, an intimate and expressive keyboard instrument, held significant prominence in northern Germanic and Nordic lands during the Galant and Classical music eras. Numerous treatises—Carl Philip Emmanuel Bach’s Essay on the True Art of Keyboard Playing, to name an early and important example—attested to its status as the ideal instrument for developing keyboard touch, technique, and expression. The simple and unique mechanics of the clavichord’s action afford more subtle expression and nuanced touch than what is possible on other keyboard instruments. These intrinsic sonic capabilities led to the development of special techniques, namely Bebung and Tragen der Töne. Although use wavered between execution and ornamentation, these techniques were described by some but were defined as specific to the clavichord by almost all keyboard treatises. Because of their absolute association to the clavichord, these ornaments permit the identification of repertoire specifically written for the clavichord—with some retrospective complications. Finding common traits among these pieces then helps to identify other repertoire that is intended for the clavichord. Through all of these things, the clavichord’s role in musicking of these periods is further informed and clarified.},
 address = {Leuven},
 author = {Proehl, Blake},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 keywords = {Clavichord},
 note = {},
 publisher = {LUCA Campus Lemmens},
 title = {Finding the Clavichord in Galant and Classical Keyboard Repertoire},
 type = {non-written output},
 url = {https://www.luca-arts.be/en/research-day-interdisciplinary-sounds},
 year = {2025}
}
