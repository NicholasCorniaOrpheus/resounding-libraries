 note = {This lecture explores Beethoven’s late piano music through the intertwined lenses of disability studies and historical keyboard technology, proposing a sensorially expanded understanding of “hearing” that includes seeing and touching. Framed from the perspective of Beethoven as a deaf pianist-composer, the talk moves beyond medicalized accounts of hearing loss to consider deafness as a socio-cultural and technological condition, shaped by objects, environments, and embodied practices. Drawing on Ian Hodder’s theory of human–thing entanglement (2012/2024), the lecture examines Beethoven’s documented relationships with different pianos—particularly the French Erard and the English Broadwood—and argues that these “foreign” instruments disrupted and reconfigured his established Viennese pianistic habits, opening new compositional affordances centered on sonority, vibration, and resonance.
Through close readings of works from the “Waldstein” Sonata to the late sonatas and the four-hand arrangement of the Grosse Fuge, alongside video demonstrations and experimental performance practices, the lecture shows how Beethoven’s music increasingly foregrounds gesture, visuality, and tactile interaction with the instrument. The talk culminates in a speculative yet practice-based exploration of “visualized sound,” inspired by Ernst Chladni’s acoustical experiments (well known to Beethoven) and contemporary disability theory’s concept of “activist affordance” (Arseli Dokumacı, 2023). Ultimately, the lecture invites performers to rethink how Beethoven’s late piano music can be played—and perceived—by attuning to non-normative, sensorially diversified modes of hearing.},
 publisher = {Technological University Dublin },
 title = {Seeing, Touching, Hearing: Exploring Intersections of Technology and Disability in Beethoven’s Late Piano Music},
 type = {non-written output},
