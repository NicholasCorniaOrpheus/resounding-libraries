@misc{Beghin_24261,
 abstract = {},
 address = {Ghent, Belgium},
 author = {Beghin, Tom},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {For Part One:
This concert offers a panorama of the clavichord repertoire from a period when the instrument was still widely popular, even as the emerging piano was coming into prominence. The program opens with the famous Carl Philipp Emanuel Bach and one of his sonatas from für Kenner und Liebhaber. Daniel Gottlob Türk, the author of the renowned Klavierschule (1789), was a passionate advocate of the clavichord throughout his life. The sonatas of Nathanael Gottfried Gruner were published in 1781 and attracted an exceptionally large number of subscribers, which supported him after a tragic fire. Among the subscribers was C. P. E. Bach.

For Part Two:
Long before forging his fine reputation as a pedagogue in London, Muzio Clementi was the first keyboard player to compose, perform publicly, and sell challenging music. In keeping with the ideals of an emerging bourgeoisie, Clementi emphasized work and practice at the piano, his Toccata Op. 11 being a perfect example. Centered on a piano built by Longman, Clementi & Co., this concert explores the diversity of effects found in the leading pianist-composers of the Clementi school.},
 publisher = {Club Falligan and Orpheus Instituut},
 title = {De Hambourg à Londres: Concert de clavichorde et pianoforte},
 type = {non-written output},
 url = {-},
 year = {2025}
}

@misc{Beghin_24262,
 abstract = {Directed by Tom Beghin, with Laura Andriani, Luca Montebugnoli, Blake Proehl, and Anastasios Zafeiropoulos.
Participants: six pianists (Ryoko Arata, Jiaqi Chen, Matías Gómez-Sáenz, Ignacio González, Martyna Horochowik, Tzu-Yu Yang) and three violinists (Sophie Paeshuyse, Anna Nefedova, Qiulin Pu), traveling to us from Germany, Poland, the Netherlands, and Brussels.
Repertoire: accompanied keyboard sonatas by L. Adam, C. P. E. Bach, M. Clementi, J. Haydn, I. Ladurner, and W. A. Mozart.
Instruments: Saxon-style clavichord (1760), pianos by Erard Frères (1803), I. Kober (1788), Longman & Clementi (1798), J. A. Stein (1786), and P. Taskin (1791).
Masterclasses, seminars, demonstrations.
Public events: open masterclasses, three concerts by the participants.
Study trip to Pianos Maene (Ruiselede).},
 address = {Ghent, Belgium},
 author = {Beghin, Tom},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {The accompanied sonata, or “sonate pour le piano forte avec accompagnement de violon,” encapsulated two performance contexts in the formative years of the eighteenth-century keyboardist: that of the lesson, where the teacher may accompany his pupil on a melodic instrument such as the flute or the violin; and that of the salon, where a violinist joins the keyboardist, ideally helping her shine in front of an audience.
Gathering around many different types of keyboards, we will explore the artistic dynamic within such relationships between keyboardists and. We do so, on the one hand, through the typical lesson material (such as Handstücke, airs, and sonatinas found in well-known tutors by J. G. Türk, L. Adam, and M. Clementi) in which the violinist can lend a didactic hand; on the other, through the preparation of salon-worthy accompanied sonatas or fantasies wherein both players elevate their art together as a duo. In addition, violinists study selected capricci from P. A. Locatelli’s L’arte del violino, honing their technique so they can assume their supporting role all the more skillfully.},
 publisher = {Orpheus Instituut},
 title = {Fourth Biennial Summer Academy: Between Lesson and Salon: Exploring the Late-Eighteenth-Century Accompanied Sonata},
 type = {non-written output},
 url = {https://orpheusinstituut.be/nl/nieuws-en-events/historical-summer-academy-2025},
 year = {2025}
}

