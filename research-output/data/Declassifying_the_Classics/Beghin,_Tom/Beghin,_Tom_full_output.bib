@misc{Beghin_24313,
 abstract = {Deze cursus behandelt de brede wereld van muziek en uitvoering.  Diverse tradities en begrippen die hieraan verbonden zijn komen aan bod: genoteerde en niet-genoteerde praktijken, historische uitvoeringspraktijken, authenticiteit, improvisatie, retoriek, expressie, virtuositeit, belichaming (‘embodiment’), en ook de verschillende hedendaagse en historische contexten waarin een uitvoering plaatsvindt, zowel ‘live’ als via opnames, en zowel door mensen als door technologische middelen. Hiernaast wordt inzicht geboden in de verschillende onderzoeksgebieden die verbonden zijn aan muziek en uitvoering, zoals analyse, cognitie, psychologie, instrumentenkunde en artistiek onderzoek, alsook de ‘performative turn’ in de musicologie van de afgelopen jaren. Als onderdeel van het vak wordt een werkbezoek aan het Orpheus Instituut in Gent gepland.},
 address = {Leuven, Belgium},
 author = {Beghin, Tom},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {This course explores the broad world of music and performance. Various traditions and concepts associated with it are addressed, including notated and non-notated practices, historical performance practices, authenticity, improvisation, rhetoric, expression, virtuosity, embodiment, as well as the different contemporary and historical contexts in which a performance takes place—both live and through recordings, and both by humans and by technological means. In addition, the course provides insight into the various research fields connected to music and performance, such as analysis, cognition, psychology, organology, and artistic research, as well as the “performative turn” in musicology in recent years. As part of the course, a study visit to the Orpheus Instituut in Ghent is planned.},
 publisher = {KU Leuven, department of musicology},
 title = {Muziek and Uitvoering},
 type = {non-written output},
 url = {-},
 year = {2023}
}
