 note = {As part of a panel on Beethoven’s Grande Fugue op. 134, this paper follows Beethoven’s interest in the acoustical studies of Ernst Chladni, who was known for his experiments in generating mostly symmetric figures in sand on a repeatedly bowed metal plate. It traces the efforts of an artistic research team (consisting of four pianists) to explore hand-and-arm choreographies, as they learned Grande Fugue in two constellations. First playing on two pianos, they removed the difficulty of interweaving string parts, following an early suggestion by Beethoven, objected to by Karl Holz because it would hamper sales: “Who has two pianos? (Kh 10, 115). As they shifted to one piano, the issue of translation between sound-producing mechanisms came into focus. Adopting what may be called an “activist” use of the piano’s affordances where regular rules no longer apply (Dokumacı 2023) they explored visualized sound, four arms producing ever-changing patterns that end up converging around suddenly transparent Chladni-like figures within an overall mesmerizing choreography.},
 publisher = {Cornell University},
 title = {Visualizing Sound: Towards a Choreography of Beethoven’s Grande Fugue op. 134},
 type = {non-written output},
 url = {https://historicalkeyboards.as.cornell.edu/forte-piano-2025},
 year = {2025}
}

@misc{Beghin_24264,
 abstract = {Panel with Elaine Sisman (Columbia University) and Robin Wallace (Baylor University)},
 address = {Ithaca, NY, USA},
 author = {Beghin, Tom},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {“Incomprehensible, like Chinese.” That’s how one Vienna reviewer described his concert experience of the final movement of String Quartet op. 130, premiered by the Schuppanzigh Quartet on March 21, 1826. This unique movement would eventually decouple from the quartet to become not one but two independent works: Grande Fugue, tantôt libre, tantôt recherchée, op. 133 for string quartet and op. 134 arranged for piano à quatre mains “by the author himself,” while op. 130 was published with a newly composed “Finale.” The three opuses together laid to rest a debate that (in brother Johann van Beethoven’s words) had divided the whole city: “Those in favor say the piece must be heard often to be understood; the others wish that it hadn’t been there because it’s too difficult to understand” (Konversationshefte 9, 137).
The publisher Mathias Artaria thought a four-hand arrangement might ease the public’s acceptance of the piece. Beethoven approved a pianist familiar to him, Anton Halm, for the commission, but rejected the result which, as Halm explained to him, had changed the voice-leading to make the players more comfortable. By mid-August 1826, Beethoven set about making his own arrangement, and a few weeks later, he authorized Karl Holz to ask for twelve ducats, saying that although he had often been of service to “Mr. M.[athias]” without payment, this time “the service that I have rendered to him [...] is too menial [knechtisch] not to have to insist on compensation” (Briefwechsel 6, 273).
Does the four-hand arrangement help decipher the string version? May it be understood on its own terms? What constitutes a successful performance of it? We ask these questions in relation to Beethoven’s last piano—the six-and-a-half octave, quadruple-strung Conrad Graf, lent to the composer on January 24, 1826, and presently in the Beethoven-Haus Bonn. De facto, op. 134 is Beethoven’s only piano work that may be associated with this instrument. A newly launched reconstruction project of it invites a reconsideration of Beethoven’s entanglements with pianos—in this case, with a relatively new Viennese grand, after years of interactions with his English Broadwood, in need of repair.},
 publisher = {Cornell University },
 title = {Understanding Beethoven’s Grande Fugue for Four Hands, Op. 134: Entangling Bodies, Strings, and Subjects},
 type = {non-written output},
 url = {https://historicalkeyboards.as.cornell.edu/forte-piano-2025},
 year = {2023}
}

