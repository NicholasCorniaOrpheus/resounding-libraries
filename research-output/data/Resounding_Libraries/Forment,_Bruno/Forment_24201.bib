@book{Forment_24201,
 abstract = {The remarkable history of the Don Juan legend and an insightful listening guide to Mozart's 'opera of operas'
How do you compose a classic about a thoroughly immoral character? With Don Giovanni (1787), Wolfgang Amadeus Mozart answered that question in a brilliant way. He gave a daring and innovative musical-dramatic voice to the legendary character, his victims and his adversaries. Together with librettist Lorenzo da Ponte, he blended light and darkness, humour and tragedy, opera buffa and opera seria with irresistible sharpness and sophistication. This booklet first explores the striking history of the Don Juan legend and the collaboration between Mozart and the Prague opera company. In the accompanying listening guide, Bruno Forment brings Mozart's dramaturgical inventions to life scene by scene. Finally, he examines how this “opera of operas” has fascinated artists, thinkers and listeners for generations.},
 address = {Leuven},
