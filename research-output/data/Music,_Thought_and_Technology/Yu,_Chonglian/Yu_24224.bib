 pages = {},
 school = {Orpheus Instituut},
 title = {Prototyping a New Compositional Paradigm: The Augmented Audience and the Internet of Wearable Musical Things},
 type = {dissertation},
 url = {https://www.docartes.be/en/research-projects/prototyping-a-new-compositional-paradigm-the-augmented-audience-and-the-internet-of-wearable-musical-things},
