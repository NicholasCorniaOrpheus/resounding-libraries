@phdthesis{Yu_24224,
 abstract = {This research explores speculative socio-technological trajectories to establish a new compositional paradigm, focusing on the concept of the augmented audience through prototyping-based wearables named the Internet of Wearable Musical Things (IoWMT). The study sets up a dual framework: a macro framework for conceptual and theoretical development and a micro framework for technical implementation and experimentation. This dual framework forms the basis of the research process, generating new compositional approaches. Together, they provide the context, techniques, and tools for the compositional practices. This research offers a reflective artistic perspective on our unpredictable technological future by converging fields ranging from computer music, human-computer interaction, speculative aesthetics, transhumanism, and gamification. It also conveys a personal attitude toward contemporary technological development.},
 address = {Ghent},
 author = {Yu, Chonglian and Impett, Jonathan and Monseré, Annelies},
 doi = {},
 howpublished = {open, Peer-reviewed},
 keywords = {},
