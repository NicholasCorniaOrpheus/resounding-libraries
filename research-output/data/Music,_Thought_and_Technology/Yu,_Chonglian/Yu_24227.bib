@misc{Yu_24227,
 abstract = {Human Receiver is an artistic project emerging from my current doctoral research, which transforms audience members into active nodes within a cyber-physical performance space through custom-built, networked wearables. The project examines how IoT network structures—centralized, decentralized, and distributed—can serve as compositional frameworks for real-time sonic and structural spatialization. Audiences embody dual identities (physical and digital) that converge at "sonic margins," the mutable boundaries where sound meets perceptual thresholds and networked cognition emerges. Drawing parallels between network topologies, proxemic patterns, and compositional techniques, the project creates dynamic environments that mirror underlying networked digital data flows. Technical implementation utilizes low-cost ESP32-based devices running modified low-latency audio streaming protocols. This presentation will detail the implementation of the cyber-physical IoT infrastructure, the networked wearable design paradigm, audio streaming protocols, and present compositional excerpts that demonstrate the creative outcomes of this project.},
 address = {},
 author = {Yu, Chonglian},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 keywords = {Computer science},
 note = {},
 publisher = {},
 title = {Human Receiver: Network Topologies as Sonic Scores},
 type = {non-written output},
 url = {https://nownetarts.org/nownet-arts-conference-2025},
 year = {2025}
}
