@article{Parra_Cancino_24177,
 abstract = {This article aims to outline an exploration of the processes of interpretation in electronic music, rooted in my broader engagement with music, technology and performance. The research presented here traverses the boundaries between composition, technology and performance, seeking to understand how these elements interact and inform each other in the practice of electronic music. The article is both a reflection on my past research and a presentation of ongoing explorations, particularly focusing on the interpretation of Éliane Radigue’s Usral (1969). I aim to offer new perspectives on the interpretation of electronic music, highlighting the complexities and opportunities that arise when dealing with non-traditional, often opaque musical tools and methods.},
 author = {Parra Cancino, Juan},
 doi = {10.1017/S0040298224001050},
 howpublished = {closed, Peer-reviewed},
