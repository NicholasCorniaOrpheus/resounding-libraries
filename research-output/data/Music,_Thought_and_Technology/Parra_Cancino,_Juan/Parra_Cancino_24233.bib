@misc{Parra_Cancino_24233,
 abstract = {Harald Bode (1909–1987) was a German engineer and pioneer of electronic musical instruments whose many inventions had a significant impact on electronic music.
His extensive archive with numerous notes, construction plans, circuit diagrams and prototype documentation has been part of the ZKM since 2019. Based on this archive, the SYNTH-Werk Munich, the ZKM | Karlsruhe and the HfM | Karlsruhe University of Music have reconstructed Bode's last completed instrument, the so-called Barberpole Phaser, an effects device that was only built three times. It is now available to a wider audience and can be used by artists and musicians worldwide.},
 address = {Karlsruhe},
 author = {Parra Cancino, Juan},
 doi = {},
 howpublished = {Open, Peer-reviewed},
 keywords = {},
 note = {Presentation in the framwork of the Reconstructing Harald bode project and symposium},
 publisher = {ZKM},
 title = {Towards an experimental performance of Harald Bode’s Phase 6},
 type = {non-written output},
 url = {https://zkm.de/en/media/videos/juan-parra-cancino-towards-an-experimental-performance-of-harald-bodes-phase-6},
 year = {2025}
}
