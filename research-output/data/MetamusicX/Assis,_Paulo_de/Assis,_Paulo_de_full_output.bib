@article{Assis_21985,
 abstract = {This paper explores the persistent fascination with discovering new digital and AI-driven note-taking apps, a phenomenon indicative of the broader reconfiguration of knowledge in the digital age. The proliferation of information, unprecedented in volume and variety, necessitates advanced tools for effective management and comprehension. The study examines the role of AI in transforming how we interact with data, presenting these applications as extensions of our cognitive capabilities. By analyzing the unique functions of various note-taking apps, the paper underscores their importance in navigating the modern knowledge landscape. Ultimately, it highlights the continuous evolution of these tools as essential companions in our quest for understanding an ever-changing world.},
 author = {Assis, Paulo de},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 issn = {12344321},
 journal = {medium.com},
 keywords = {},
 note = {Article for general public readership.},
 number = {Y},
 pages = {a--b},
 title = {Why the Frantic with Digital Note Taking Apps: a Reconfiguration of Knowledge?},
 type = {article},
 url = {https://medium.com/@paulo.deassis/why-the-frantic-with-digital-note-taking-apps-a-reconfiguration-of-knowledge-dbb294fed379},
 volume = {X},
 year = {2023}
}

@article{Assis_21986,
 abstract = {This paper examines the transformative impact of bespoke GPT-4 models on academic writing workflows. By leveraging OpenAI’s user-friendly interface to create customized GPT models, tailored to specific needs and writing styles, the author experienced significant improvements in speed, diversity, and quality control of their writing. The custom model, trained on the author's extensive body of work, provided exceptional feedback, constructive criticism, and insightful suggestions, effectively acting as a highly capable personal assistant. The integration of these bespoke GPTs into the writing process allowed for a more balanced and reader-friendly output, reducing reliance on human feedback and enhancing the overall quality of academic writing. This study underscores the potential of personalized AI tools to revolutionize traditional writing methods and highlights the profound benefits of integrating AI into creative workflows.},
 author = {Assis, Paulo de},
 doi = {},
 howpublished = {open, Not peer-reviewed},
 issn = {12344321},
 journal = {medium.com},
 keywords = {},
 note = {},
 number = {0},
 pages = {0},
 title = {How I created my own GPTs and how it is transforming my academic writing},
 type = {article},
 url = {https://medium.com/@paulo.deassis/how-i-created-my-own-gpts-and-how-it-is-transforming-my-academic-writing-71a5e45000fa},
 volume = {0},
 year = {2023}
}

