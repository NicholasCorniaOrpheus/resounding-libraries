@misc{Łukawski_24172,
 abstract = {This 90-minute lecture (followed by 30 minutes of Q&A) presented two interlinked strands of research on blockchain as a compositional and cultural infrastructure. First, it introduced Decentralized Music: Exploring Blockchain for Artistic Research (co-edited with Paulo de Assis), outlining the book’s aims, key questions, and contributions to artistic research in music—from provenance and authorship to new forms of distribution, collaboration, and value. Second, it developed the concept of Performative Transactions, a framework for encoding compositional processes as interoperable, reusable operations that can be enacted by humans and AI agents within decentralised creative networks. Across both topics, the talk argued for shifting attention from blockchain as a tool for asset ownership to blockchain as a medium for organising creative agency, documenting conditions of practice, and enabling compositional systems that are built collectively over time.},
 address = {Ghent, Belgium},
 author = {Łukawski, Adam},
 doi = {},
 howpublished = {Open, Peer-reviewed},
 keywords = {},
 note = {},
 publisher = {Orpheus Institute},
 title = {Performative Transactions: Composing Agential Systems in Music (Lecture)},
 type = {non-written output},
 url = {https://orpheusinstituut.be/education/other/farm},
 year = {2023}
}
