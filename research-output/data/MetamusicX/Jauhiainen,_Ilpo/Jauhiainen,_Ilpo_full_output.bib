@phdthesis{Jauhiainen_22786,
 abstract = {The research examines the potentiality of emergence and environmental intelligence as a compositional and performative tool. It focuses on a de/reterritorialization process that – to borrow from Deleuzian terminology – is becoming-environment of music and becoming-music of an environment. The key questions are: how could environmental intelligence – an integration of environmental data and knowledge with artificial intelligence (AI) – be applied as a compositional system for generative music? And how could environmentally sensitive and responsive music operate in the age of accelerated environmental change and ever-ubiquitous intelligent technology?

Drawing from Assemblage Theory, Hyperobjects, New Materialism and Posthumanism, the research seeks to formulate a new 21st century musical practice and aesthetic as that of a constructive agency between environment, music, technology and philosophy; to posit an idea of composer/performer as a facilitator – philosopher, gardener, catalyst – between contemporary society, science and sonic arts. It aims to develop an ecosystemic approach to 'AI in music' where AI operates as one of the agents in a greater ecology of human and more-than-human intelligences. The focus is on generative (self-organising and -evolving) musical practices that cover electroacoustic and contemporary classical music, new global musical styles as well as the emerging possibilities and combinations of music and sound art.

Alongside written theoretical work and a series of compositions and performances, the practice-based research consists of developing an AI application (‘Terrestrial’) that will act as an intelligent algorithmic tool between the composer/performer and a given environment (e.g. an ecosystem, hyperobject, network or assemblage) – actual or virtual.},
 address = {Ghent},
 author = {Jauhiainen, Ilpo and Cobussen, Marcel and Assis, Paulo de},
 doi = {},
 howpublished = {open, Peer-reviewed},
 keywords = {},
 note = {},
 pages = {},
 school = {Orpheus Instituut},
 title = {Terrestrial: Toward an ecological emergence in music},
 type = {dissertation},
 url = {https://www.docartes.be/en/research-projects/terrestrial-toward-an-ecological-emergence-in-music},
 year = {2028}
}

@misc{Jauhiainen_24178,
 abstract = {SIINTO (Finnish for ‘shimmer’, ‘dawn’, ‘reflection’, ‘glow’) presents three compositions – or ‘geomusical objects’, as I began to hear them – that play with the notion of music as an environment and environment as music, exploring the potential between geography and music.

The album forms part of my broader artistic research into hypermusic, geomusic, and posthuman music.

The tracks are long (20 minutes), with the ‘hooks’ occurring slowly and gradually over the course of the entire tracks; this is to better cater to the current demand for 2-minute songs with instant 15-second hooks.

(for a new culture is to be found in the spaces, silences and ruptures too incomprehensible to the optimisation algorithms)

It is meant as music to swim in, roam through, get lost in or bored by, zoom in/out of, journey with, discover alongside other things, be exited and returned to at any point.

Siinto and its variation Saraste (‘morning’, ‘dusk’, ‘first light’) originate from my artist residency at KulttuuriKauppila in Ii, Finland, July-August 2024: while there, I was invited to create a site-specific live performance that drew its inspiration and most of its sonic material from the local geography of Ii. The title track also features the voice of a dear friend who was born in Ii, abstracted from a poetry recording we had made years earlier; and while in the performance the voice travelled as a clearer figure in a landscape, here it has become more ecological – a sustaining part of that environment.

Kajo (‘soft light’, ‘reflection’) forms the backing track I created for poet Sanna Karlström’s spoken word performance at Sähkö #42 in Jyväskylä, Finland, September 2023. The idea has again been for a situation/site-specific soundscape composition, drawing thematically and sonically from the local environment and culture – and, in this case, from the content of Karlström’s poems as well. The collaboration was made possible by my residency at the Writers’ House/Kirjailijatalo in Jyväskylä, May-December 2023.

A particularly vital layer in these geomusical objects emerges from the ‘stratified’ recordings of Ginette, originally performed by Petteri Mäkiniemi.},
 address = {},
 author = {Jauhiainen, Ilpo and Jauhiainen, Ilpo},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {Electronic music, Instrumental music, Minimalist music},
 note = {},
 publisher = {},
 title = {SIINTO},
 type = {non-written output},
 url = {https://open.spotify.com/album/7rJWfeylhALvvkzzceLHcl},
 year = {2025}
}

@misc{Jauhiainen_24236,
 abstract = {My research project Terrestrial: Toward new poetics of geomusics examines the aesthetic, philosophical and technological dimensions of geomusical intelligence – an integration of geophilosophy, geomusic and environmental intelligence  – in generative music composition.

It addresses the (tentative) research question of how could environmental intelligence – an integration of environmental data and knowledge with artificial intelligence – be applied as a compositional system for generative music?

Drawing from Assemblage Theory, Hyperobjects, New Materialism and Posthumanism, the project seeks to advance the field of geomusic and formulate a new 21st century musical practice and aesthetic as that of a constructive agency between environment, music, technology and philosophy. Examining new liminal conditions and connections between these, I aim to articulate a new kind of posthumanist musical thinking through the application of environmental input and generative processes, and to contemplate and advance the applications of AI and non-musical data as meaningful compositional tools. I seek to develop the role of composer as that of an active agent within a larger compositional assemblage of human and more-than-human actors; to posit an idea of composer as a facilitator – philosopher, gardener, catalyst – between contemporary society, science and sonic arts.

The project will build on a long history of musical practice that could be described as generative, aleatoric, process or algorithmic music. It will expand and advance this musical evolution by incorporating the latest advances in intelligent systems as well as climate and environmental science and by applying those advances creatively to compositional and performance techniques and processes. It will also extend its scope to non-Western musical traditions and examine generative and algoritmic processes in those traditions in order to create a more global sounding contemporary music.

At the core of this practice-based research – alongside experimentative compositions, sound installations and performances as well as academic papers and essays – are the development of an AI application titled Terrestrial and the formulation of the concept of geomusical objects, both of which will constitute the main aesthetico-epistemic topography leading to my dissertation.},
 address = {Ghent},
 author = {Jauhiainen, Ilpo and Jauhiainen, Ilpo and Cobussen, Marcel and Assis, Paulo de},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {},
 note = {},
 publisher = {Orpheus Instituut / Leiden University},
 title = {Terrestrial: Toward new poetics of geomusics},
 type = {non-written output},
 url = {https://drive.google.com/drive/folders/1o9rBgY0lDmBiA2hay0sfcxjhrhRDgB2u?usp=sharing},
 year = {2025}
}

@article{Jauhiainen_24280,
 abstract = {This essay examines the challenges of generative AI in composing ‘new’ music. The focus is on the commercial generative AI applications (i.e. AI music generators) due to their prominence in the mainstream cultural and technological discourse. The essay adopts a philosophical rather than a technological approach, situating the use of generative AI in music within a broader societal, cultural, and environmental context. If AI and music (understood as normative practices) are majoritarian, molar, and arborescent entities, then the approach taken here is Deleuzian: minoritarian, molecular, and rhizomatic. By engaging with their fault lines, disassembling and reassembling their structures, and connecting them to the wider world, the essay presents an alternative way of thinking about AI and music – and AI in music – and proposes one such possible application.},
 author = {Jauhiainen, Ilpo},
 doi = {10.22501/rc.3655482},
 howpublished = {Open, Not peer-reviewed},
 issn = {07840942},
 journal = {Research Catalogue},
 keywords = {Artificial intelligence, Electronic music, Music, Music criticism, Music philosophy and aesthetics, Music production, Technology, Capitalism},
 note = {},
 number = {I},
 pages = {xxx--yyy},
 title = {Berlin, lava fields, rebellion, street life: Rethinking the application of AI in music},
 type = {article},
 url = {},
 volume = {V},
 year = {2025}
}

@misc{Jauhiainen_24296,
 abstract = {This algorithmic environmental composition explores the notion of geomusic in relation to algorithmic (generative) music composition. It combines humpback whale vocalisations, recorded in the Pacific Ocean near Hawaii, with abstracted 'musical' sounds made of field recordings, recorded in a forest in Central Finland. The piece is generative (i.e. self-organising) in nature and basically infinite, of which this recording represents an hour-long segment. The recording forms the first practical experiment toward my new 'geomusical' practice and of my doctoral research project Terrestrial: Toward new poetics of geomusics.},
 address = {Ghent},
 author = {Jauhiainen, Ilpo and Jauhiainen, Ilpo},
 doi = {},
 howpublished = {Open, Not peer-reviewed},
 keywords = {Aleatory music, Electronic music, Incidental music, Instrumental music, Minimalist music},
 note = {Part of my doctoral research project Terrestrial: Toward new poetics of geomusics.},
 publisher = {Orpheus Instituut / Leiden University},
 title = {Geomusic 001},
 type = {non-written output},
 url = {https://drive.google.com/file/d/1WfT5EmAbjfk95jnPFykxDuCBtyU5OW1K/view?usp=sharing},
 year = {2025}
