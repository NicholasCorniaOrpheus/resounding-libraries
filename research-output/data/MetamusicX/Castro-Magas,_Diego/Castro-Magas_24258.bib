@misc{Castro-Magas_24258,
 abstract = {In this position statement, I outline the main aspects of 'Radically Embodied Performance as Musical
Structure', a postdoctoral project funded by the Marie Skłodowska-Curie programme (March 2025–
February 2027) hosted at the Orpheus Instituut in Ghent, with primary supervision by Paulo de
Assis. As point of departure, this project investigates compositional and notational practices that
evidence a performative transformation of musical material. Here, sound-producing actions become
intrinsic layers of the music itself instead of being mere ‘means to an end’ — as if the composer
bypasses the performer as a person and writes directly for her body. This approach challenges the
performer’s role as a creative agent and urges a rethinking of traditional ontologies of the musical
work. The aim is to nurture a new concept: ‘Radically Embodied Performance’. This concept frames
the performer-specific counterpart to the compositional practices above described, encompassing
not only interpretive and performative approaches to notation but also improvisational practice and
novel understandings of (embodied) musical structure for music analysis, as well as revised
ontologies of musical works. The project draws on paradigms from cognitive science (Anthony
Chemero’s Radical Embodiment), performance practice (Pavlos Antoniadis’ Embodied Navigation),
compositional practice (Richard Barrett’s Radically Idiomatic Instrumentalism), music ontology
(Paulo de Assis on the post-Deleuzian assemblage theory for music), semiotics and psychoanalytic 
theory (Roland Barthes’ concept of somatheme), and affect theory (Eugenie Brinkema’s Radical
Formalism). I will illustrate how this epistemological framework is likely to structure a particular
embodied research methodology concerned with contemporary performance, examining its
potential scope and limitations.},
 address = {London, UK},
 author = {Castro-Magas, Diego},
